# Local CMake compilation output
/build/

# Python bytecode
__pycache__/
*.py[cod]

# Scenario and latency reproduction outputs
/results/

# Temporary historical-source worktrees
/.historical-worktrees/

# Reconstructed Gen3 + 2F-85 mc_rtc robot module
# Generated from external upstream packages and not tracked here.
/gen3_2f85_module/

# Optional environment used to regenerate result figures
/.venv-figures/

# mc_rtc binary logs of two-robot simulation runs (hundreds of MB)
two_robot/results/**/*.bin

# LaTeX build products of the paper
paper/*.log
paper/*.aux
paper/*.out

# Local two-robot simulation runs (the recorded run is sim_2026-09-24/)
/two_robot/results/*/
!/two_robot/results/sim_2026-09-24/
